# ---- Core ----
NODE_ENV=production
PORT=3000
APP_URL=https://app.yourdomain.com
APP_NAME=ChatPilot AI
DB_PATH=./data/chatpilot.db
# openssl rand -hex 32
JWT_SECRET=change-me-long-random-string
# openssl rand -hex 32   (KEEP SAFE: losing it makes stored page tokens and chats unreadable)
ENCRYPTION_KEY=
# Comma-separated emails that become platform admins on sign-up
ADMIN_EMAILS=you@yourdomain.com
TRIAL_DAYS=14
# Background jobs (follow-ups, lifecycle emails, retention) run every N seconds
WORKER_INTERVAL_SEC=300

# ---- AI (Anthropic Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high  (low = cheapest/fastest; good for chat replies)
AI_EFFORT=low

# ---- Stripe payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_LIFETIME=

# ---- Everything below can ALSO be set from Admin → Settings (DB values win) ----
SUPPORT_EMAIL=
# Google OAuth (Sign in with Google). Redirect: $APP_URL/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft OAuth (Sign in with Microsoft). Redirect: $APP_URL/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# System email for password resets, verification, daily briefings, alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Telegram bot for customer alerts (create with @BotFather)
TELEGRAM_BOT_TOKEN=

# ---- Security ----
# Key rotation: put the NEW key in ENCRYPTION_KEY, bump the version, keep the old one here until
# Admin → Security center → "Re-encrypt with current key" has run. Format: "1:<64 hex>,2:<64 hex>"
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEYS_OLD=
# Number of reverse proxies in front of the app (Caddy/Nginx/Cloudflare = 1) — needed for correct client IPs
TRUST_PROXY_HOPS=1
# Per-IP limit for sign-in/sign-up requests per 15 minutes
AUTH_RATE_LIMIT=30

# ---- Social sales (Messenger / Instagram / WhatsApp) ----
# Graph API version used for sending messages
META_GRAPH_VERSION=v21.0
# Wait this long for more messages from the same customer before answering (ms)
SALES_DEBOUNCE_MS=4000
