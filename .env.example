# ---- Core ----
NODE_ENV=production
PORT=3000
APP_URL=https://app.yourdomain.com
APP_NAME=MailPilot AI
DB_PATH=./data/mailpilot.db
# openssl rand -hex 32
JWT_SECRET=change-me-long-random-string
# openssl rand -hex 32   (KEEP SAFE: losing it makes stored mailbox passwords unreadable)
ENCRYPTION_KEY=
# Comma-separated emails that become platform admins on sign-up
ADMIN_EMAILS=you@yourdomain.com
TRIAL_DAYS=14
SYNC_INTERVAL_SEC=120

# ---- AI (Anthropic Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high  (low = cheapest/fastest, good for email triage)
AI_EFFORT=low

# ---- Stripe payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_LIFETIME=

# ---- Everything below can ALSO be set from Admin → Settings (DB values win) ----
SUPPORT_EMAIL=
# Google OAuth (Sign in with Google + one-click Gmail). Redirect: $APP_URL/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft OAuth (Sign in with Microsoft + one-click Outlook). Redirect: $APP_URL/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# System email for password resets, verification, daily briefings, alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Telegram bot for customer alerts (create with @BotFather)
TELEGRAM_BOT_TOKEN=
