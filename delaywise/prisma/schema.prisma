// Delaywise data model.
// Privacy by design: we never store customer names, emails, phone numbers or
// addresses. Customer contact details are fetched from Shopify at send time
// and discarded. Only order/fulfillment identifiers and shipping status live here.

generator client {
  provider = "prisma-client-js"
}

// SQLite by default. DATABASE_URL must point at a file on a persistent disk in
// production (see docs/DEPLOY.md). Tests use their own throwaway file.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop                     String   @id
  plan                     String   @default("free") // free | starter | growth | pro
  mode                     String   @default("approval") // approval | autopilot
  tone                     String   @default("friendly") // friendly | professional | playful
  shopCountry              String? // ISO code, used to tell domestic from international
  shopName                 String?
  brandName                String?
  replyToEmail             String?
  signature                String?
  defaultTransitDays       Int      @default(5)
  graceHours               Int      @default(24)
  stallHours               Int      @default(72)
  notifyOnStall            Boolean  @default(true)
  notifyOnDelay            Boolean  @default(true)
  notifyOnException        Boolean  @default(true)
  compensationEnabled      Boolean  @default(false)
  compensationPercent      Int      @default(10)
  compensationMinDaysLate  Int      @default(3)
  onboardingCompleted      Boolean  @default(false)
  // F4: extra instructions for the AI writer (merchant-provided, treated as data).
  brandInstructions        String?
  // F5: exclusions. Comma-separated tags / ISO country codes.
  excludedTags             String?
  excludedCountries        String?
  minOrderValue            Float    @default(0)
  // F6: send window in the shop's timezone (hours 0-23). Equal values = any time.
  timezone                 String?
  sendWindowStart          Int      @default(8)
  sendWindowEnd            Int      @default(20)
  // F7: per-carrier transit days, JSON object {"usps": 5, "dhl express": 2}.
  carrierTransitDays       String?
  // R1: extra business days added to every estimate (peak season / holidays).
  extraTransitDays         Int      @default(0)
  // F2 / F3 / F1
  deliveredFollowUp        Boolean  @default(true)
  merchantDigest           Boolean  @default(true)
  digestEmail              String?
  lastDigestAt             DateTime?
  flowTriggerEnabled       Boolean  @default(true)
  // U1: when the one-click setup was completed.
  setupDoneAt              DateTime?
  /// Setup guide steps the merchant finished or hid (comma list).
  guideDone                String?
  // U1: style preset (gentle | balanced | proactive | custom).
  preset                   String   @default("balanced")
  // U4: VIP orders always wait for approval, even on Autopilot.
  vipMinOrderValue         Float    @default(0)
  vipTags                  String?  @default("vip")
  // U3: same carrier + country problems that count as an incident.
  incidentThreshold        Int      @default(5)
  // R4: show a delay notice on the customer's order-status page.
  orderStatusNotice        Boolean  @default(true)
  // R3: Klaviyo integration. Private key encrypted with APP_ENCRYPTION_KEY.
  klaviyoEnabled           Boolean  @default(false)
  klaviyoApiKeyEnc         String?
  // H2: per-shop lease so two scans never run at once.
  scanLockUntil            DateTime?
  scanLockToken            String?
  // F12
  lastScanAt               DateTime?
  lastScanError            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Shipment {
  id               String    @id @default(cuid())
  shop             String
  orderId          String // Shopify GID
  orderName        String
  orderValue       Float     @default(0)
  currency         String    @default("USD")
  fulfillmentId    String // Shopify GID
  carrier          String?
  trackingNumber   String?
  trackingUrl      String?
  customerLocale   String? // e.g. "de", "fr-CA" (not personal data)
  destinationCountry String? // ISO country code only
  shippedAt        DateTime
  expectedBy       DateTime?
  status           String    @default("UNKNOWN") // normalized, see app/lib/status.ts
  lastEventAt      DateTime?
  lastCheckedAt    DateTime?
  deliveredAt      DateTime?
  source           String    @default("shopify") // shopify | ship24
  externalTrackerId String?
  risk             String    @default("none") // none | watch | stalled | delayed | exception | lost
  riskReason       String?
  riskSince        DateTime?
  notifiedRisk     String? // highest risk level the customer was already told about
  followUpSent     Boolean   @default(false) // F2
  importedOverdue  Boolean   @default(false) // V-H2: already long overdue when first seen
  vip              Boolean   @default(false) // U4
  handledAt        DateTime? // U5: merchant took care of it; no more emails or workflows
  handledBy        String?
  excluded         Boolean   @default(false) // F5
  excludedReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]

  @@unique([shop, fulfillmentId])
  @@index([shop, risk])
  @@index([shop, status])
}

model Message {
  id           String    @id @default(cuid())
  shop         String
  shipmentId   String
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind         String // stalled | delayed | exception | lost | delivered
  language     String
  subject      String
  body         String
  generatedBy  String    @default("ai") // ai | template
  discountCode String? // M4: chosen when drafted, created in Shopify only when sent
  discountPercent Int?
  discountCreated Boolean  @default(false)
  attempts     Int       @default(0) // L2: send attempts
  sendingSince DateTime? // V-M1: when a send was claimed, to recover interrupted sends
  status       String    @default("pending_approval") // pending_approval | scheduled | sending | sent | skipped | failed
  scheduledFor DateTime? // F6: autopilot emails waiting for the send window
  // F11: discount redemption
  discountRedeemedAt DateTime?
  discountOrderName  String?
  discountOrderValue Float?
  error        String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  @@unique([shipmentId, kind]) // H2: one email per shipment per situation
  @@index([shop, status])
}

/// M7: orders whose customer data Shopify asked us to erase; never re-imported.
model RedactedOrder {
  id      String   @id @default(cuid())
  shop    String
  orderId String
  createdAt DateTime @default(now())

  @@unique([shop, orderId])
}

model UsageMonth {
  id               String @id @default(cuid())
  shop             String
  month            String // "2026-11"
  shipmentsTracked Int    @default(0)
  paidLookups      Int    @default(0)
  messagesSent     Int    @default(0)
  overageBilled    Int    @default(0) // paid lookups already reported as usage charges

  @@unique([shop, month])
}

/// S4: webhook deliveries already processed (Shopify may deliver more than once).
model ProcessedWebhook {
  id        String   @id @default(cuid())
  webhookId String   @unique
  shop      String
  topic     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// S5: who did what, for the merchant's activity log.
model AuditLog {
  id        String   @id @default(cuid())
  shop      String
  actor     String // staff user id, "Autopilot" or "System"
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
