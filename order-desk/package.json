{
  "name": "order-desk",
  "version": "0.1.0",
  "description": "AI Order Desk - turns emailed purchase orders (PDF, Excel, CSV, images, email text) into draft orders on any commerce platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "create-store": "node --no-warnings=ExperimentalWarning scripts/create-store.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "mailparser": "^3.15.0"
  }
}
